APP_NAME=Agentra API
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.hzggafggwnomeoosjcgl
# Enter the raw database password in single quotes; do not URL-encode it.
DB_PASSWORD=''
DB_SSLMODE=require
CORS_ORIGINS=["http://localhost:5173"]

# Backend-only random signing secret (at least 32 UTF-8 bytes). Required for API startup.
# Alembic/seed/verification commands do not require this key.
AUTH_SIGNING_KEY=''
AUTH_ISSUER=agentra-api
AUTH_AUDIENCE=agentra-ui
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_RESET_TTL_SECONDS=1800

# Single worker/replica only; the limiter uses an application-local atomic store.
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT=120
AUTH_RATE_WINDOW_SECONDS=60
# Per matched business operation, authenticated actor and direct peer.
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_RESET_REQUEST_LIMIT=3
AUTH_RESET_REQUEST_WINDOW_SECONDS=900
AUTH_RESET_LIMIT=10
AUTH_RESET_WINDOW_SECONDS=60

# Disabled mail returns account-independent 503 for reset requests.
AUTH_MAIL_ENABLED=false
AUTH_RESET_URL=''
AUTH_RESET_RESPONSE_FLOOR_SECONDS=6
SMTP_HOST=''
SMTP_PORT=587
SMTP_FROM=''
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=5
