APP_NAME=Agentra API
# Neon PostgreSQL (Singapore). Runtime uses the PgBouncer pooled host (-pooler).
DB_HOST=ep-your-endpoint-pooler.c-4.ap-southeast-1.aws.neon.tech
# Direct host for pg_dump/pg_restore only; the app ignores this key.
DB_HOST_DIRECT=ep-your-endpoint.c-4.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
# Enter the raw database password in single quotes; do not URL-encode it.
DB_PASSWORD=''
DB_SSLMODE=require

# Optional accepted sandbox: configure every field together; no provider enabled by default.
PAYMENT_PROVIDER=
PAYMENT_BASE_URL=
PAYMENT_CALLBACK_URL=
PAYMENT_CREDENTIAL=
PAYMENT_WEBHOOK_KEYS={}
PAYMENT_TIMEOUT_SECONDS=5
PAYMENT_EXPIRY_SECONDS=1800

# Native VNPAY sandbox checkout/IPN/Return/query/refund settings.
# Configure these directly in backend/.env for local development and Docker Compose.
# Keep these separate from the controlled PAYMENT_* protocol above.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=''
# Distinct HTTPS URLs; once either credential is set, all four fields are required.
VNPAY_IPN_URL=
VNPAY_RETURN_URL=

CORS_ORIGINS=["http://localhost:5173"]

# Backend-only random signing secret (at least 32 UTF-8 bytes). Required for API startup.
# Alembic/seed/verification commands do not require this key.
AUTH_SIGNING_KEY=''
AUTH_ISSUER=agentra-api
AUTH_AUDIENCE=agentra-ui
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_RESET_TTL_SECONDS=1800

# Single worker/replica only; the limiter uses an application-local atomic store.
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT=120
AUTH_RATE_WINDOW_SECONDS=60
# Per matched business operation, authenticated actor and direct peer.
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_RESET_REQUEST_LIMIT=3
AUTH_RESET_REQUEST_WINDOW_SECONDS=900
AUTH_RESET_LIMIT=10
AUTH_RESET_WINDOW_SECONDS=60

# Disabled mail returns account-independent 503 for reset requests.
AUTH_MAIL_ENABLED=false
AUTH_RESET_URL=''
AUTH_RESET_RESPONSE_FLOOR_SECONDS=6
SMTP_HOST=''
SMTP_PORT=587
SMTP_FROM=''
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=5
