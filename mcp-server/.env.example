# Agentra MCP server (FastMCP). Copy to .env for local runs; Docker Compose sets these.
# Backend origin: the OpenAPI document and every tool call go to {origin}/api/...
AGENTRA_API_URL=http://localhost:8000
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_PATH=/mcp
# Public base URL of this server (protected-resource metadata in 401 responses).
MCP_PUBLIC_URL=
MCP_TOKEN_CACHE_SECONDS=30
MCP_REQUEST_TIMEOUT_SECONDS=20
MCP_STARTUP_RETRIES=10
