{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": {
        "index.py": {
          "maxDuration": 60,
          "includeFiles": "app/modules/{document_history/fonts,reports/assets,online_payments/assets}/**"
        }
      }
    },
    "mcp": {
      "root": "mcp-server",
      "entrypoint": "index:app"
    },
    "frontend": {
      "root": "ui",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/", "destination": "/index.html" },
        { "source": "/((?!assets/).*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/mcp", "destination": { "service": "mcp" } },
    { "source": "/mcp/(.*)", "destination": { "service": "mcp" } },
    { "source": "/\\.well-known/oauth-protected-resource(.*)", "destination": { "service": "mcp" } },
    { "source": "/", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
