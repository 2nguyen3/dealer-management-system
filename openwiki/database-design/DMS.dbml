// DBML cho dbdiagram.io, chuyển từ backend/alembic/sql/0011_simplified_schema.sql.
// Giữ tên schema/bảng/cột, nullability, PK/FK, CHECK, default và index.
// Generated columns, PostgreSQL domains, partial indexes, DEFERRABLE và
// trigger/routine được chú thích; backend/alembic/sql là nguồn DDL có version.

Project Agentra_DMS {
  database_type: 'PostgreSQL'
  Note: '''
    Mô hình đơn giản hóa 14/11/2026 (revision 0011): 16 bảng trong schema dms.
    0011 DROP SCHEMA dms CASCADE rồi dựng lại toàn bộ; không có downgrade
    (rollback = Neon branch backup). Dán toàn bộ file vào dbdiagram.io để xem sơ đồ.

    Chỉ còn 3 loại chứng từ: STOCK_RECEIPT (PN-), STOCK_ISSUE (PX-),
    PAYMENT_RECEIPT (PT-); 3 trạng thái DRAFT -> POSTED -> CANCELLED.
    Số dư hiện tại là hai cột: agency.debt và product.stock (kèm
    product.lastPurchasePrice), chỉ đổi trong thao tác ghi sổ/hủy/sửa có lý do
    (dms.posting_context()). Không còn ledger, batch, revision, dư có hay hoàn tiền.

    Các kiểu money_vnd, quantity_value và price_rate là PostgreSQL DOMAIN
    trên NUMERIC không typmod, không phải enum hoặc bảng danh mục:
    - money_vnd: tiền nguyên VNĐ, abs(value) < 10^18, loại NaN.
    - quantity_value: tối đa 3 số lẻ, abs(value) < 10^15, loại NaN.
    - price_rate: 0 < value < 1000, tối đa 6 số lẻ, loại NaN.

    increment biểu diễn identity; SQL dùng GENERATED ALWAYS AS IDENTITY.
    Cột generated stored chỉ có ghi chú, không giả thành DEFAULT.
    Mọi bảng có createdAt/updatedAt; trigger stamp_row đặt thời gian theo
    dms.app_now() = dms.clock (chỉ seed đặt) hoặc clock_timestamp().
    payment_event và audit_log là append-only.

    DBML không tái tạo trigger, routine, seed, quyền DB hoặc DEFERRABLE.
    Predicate/opclass của index được lưu trong note.
    Không dùng SQL export từ DBML để thay thế DDL khi triển khai.
  '''
}

// -----------------------------------------------------------------------------
// Người dùng và phân quyền
// -----------------------------------------------------------------------------

Table dms.user_group {
  id integer [pk, not null, increment]
  code text [not null, unique, check: `btrim(code) <> ''`]
  name text [not null, unique, check: `btrim(name) <> ''`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: '0011 tạo sẵn 4 nhóm: MANAGEMENT Quản lý, SALES Kinh doanh, WAREHOUSE Kho, ACCOUNTING Kế toán.'
}

Table dms.app_function {
  id integer [pk, not null, increment]
  code text [not null, unique, check: `btrim(code) <> ''`]
  name text [not null, check: `btrim(name) <> ''`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: '''
    22 chức năng (0011): users.manage, groups.manage, permissions.manage, rules.manage,
    agency_type.manage, unit.manage, product.manage, agency.read, agency.manage,
    stock.receipt.prepare/post, stock.issue.prepare/post, cash.receipt.prepare/post,
    documents.correct, documents.cancel, sales.read, debt.read, reports.read,
    audit.read, payments.online (Thanh toán trực tuyến). Mã ổn định cho phân quyền và nhật ký.
  '''
}

Table dms.app_user {
  id bigint [pk, not null, increment]
  "fullName" text [not null, check: `btrim("fullName") <> ''`]
  email text [not null, check: `email = btrim(email) AND position('@' IN email) > 1`]
  "passwordHash" text [not null, check: `btrim("passwordHash") <> ''`]
  "groupId" integer [not null]
  status text [not null, default: 'ACTIVE', check: `status IN ('ACTIVE', 'LOCKED')`]
  "authVersion" integer [not null, default: 1, check: `"authVersion" > 0`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (`lower(email)`) [unique, name: 'uq_app_user_email_ci']
    (groupId, id) [name: 'ix_app_user_group']
  }
  Note: 'Email đăng nhập duy nhất không phân biệt hoa/thường. Trigger guard_auth_version tăng authVersion khi đổi mật khẩu, nhóm hoặc trạng thái.'
}

Table dms.group_permission {
  id bigint [pk, not null, increment]
  "groupId" integer [not null]
  "functionId" integer [not null]
  "isAllowed" boolean [not null, default: false]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (groupId, functionId) [unique]
    functionId [name: 'ix_group_permission_function']
  }
  Note: 'Phân quyền mặc định: Quản lý mọi chức năng; Kinh doanh đại lý/lập phiếu xuất/doanh số/công nợ; Kho danh mục hàng, nhập và ghi sổ xuất; Kế toán phiếu thu, công nợ, báo cáo, thanh toán trực tuyến.'
}

Table dms.auth_token {
  id bigint [pk, not null, increment]
  "userId" bigint [not null]
  purpose text [not null, check: `purpose IN ('REFRESH', 'PASSWORD_RESET')`]
  "tokenDigest" bytea [not null, unique, check: `octet_length("tokenDigest") = 32`]
  "expiresAt" timestamptz [not null]
  "revokedAt" timestamptz
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  "authVersion" integer [not null, check: `"authVersion" > 0`]
  "sessionId" uuid

  checks {
    `"expiresAt" > "createdAt"`
    `(purpose = 'REFRESH') = ("sessionId" IS NOT NULL)`
  }
  indexes {
    (userId, purpose) [name: 'ix_auth_token_user']
    expiresAt [name: 'ix_auth_token_expiry', note: 'PARTIAL: WHERE "revokedAt" IS NULL']
    (userId, sessionId) [name: 'ix_auth_token_session']
    sessionId [unique, name: 'uq_auth_token_live_session', note: 'PARTIAL: WHERE purpose=REFRESH AND revokedAt IS NULL']
  }
  Note: 'Chỉ lưu digest token ngẫu nhiên. REFRESH giữ sessionId qua rotation. Identity/expiry bất biến; revokedAt chỉ chuyển NULL sang thời điểm thu hồi một lần (guard_auth_token). Seed v2 không tạo token.'
}

// -----------------------------------------------------------------------------
// Quy định và danh mục
// -----------------------------------------------------------------------------

Table dms.business_rule {
  id boolean [pk, not null, default: true, check: `id`]
  "maxAgenciesPerWard" integer [not null, default: 4, check: `"maxAgenciesPerWard" > 0`]
  "sellingPriceRate" price_rate [not null, default: 1.02]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Singleton id=true. QĐ1 giới hạn đại lý ACTIVE mỗi phường/xã; QĐ2 đơn giá xuất = round(lastPurchasePrice × sellingPriceRate). guard_rules chặn xóa và chặn giảm giới hạn dưới số đại lý đang hoạt động.'
}

Table dms.ward {
  id integer [pk, not null, increment]
  code text [not null, unique, check: `code ~ '^[0-9]{5}$'`, note: 'Mã GSO']
  name text [not null, unique, check: `btrim(name) <> ''`]
  kind text [not null, check: `kind IN ('WARD', 'COMMUNE', 'SPECIAL_ZONE')`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: '168 phường/xã/đặc khu TP.HCM sau 01/7/2025 (NQ 1685/NQ-UBTVQH15: 113/54/1), 0011 chép nguyên từ 0010; chỉ đọc, không trạng thái.'
}

Table dms.agency_type {
  id integer [pk, not null, increment]
  code text [not null, unique, check: `btrim(code) <> ''`]
  name text [not null, unique, check: `btrim(name) <> ''`]
  "maxDebt" money_vnd [not null, check: `"maxDebt" >= 0`]
  status text [not null, default: 'ACTIVE', check: `status IN ('ACTIVE', 'INACTIVE')`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: '0011 tạo Loại 1 (50.000.000đ) và Loại 2 (20.000.000đ). QĐ3: nợ sau khi ghi sổ phiếu xuất ≤ maxDebt. guard_rules chặn giảm maxDebt xuống dưới nợ hiện tại của đại lý thuộc loại.'
}

Table dms.unit {
  id integer [pk, not null, increment]
  code text [not null, unique, check: `btrim(code) <> ''`]
  name text [not null, unique, check: `btrim(name) <> ''`]
  "allowsFraction" boolean [not null, default: false]
  status text [not null, default: 'ACTIVE', check: `status IN ('ACTIVE', 'INACTIVE')`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Đơn vị không cho số lẻ chỉ nhận số nguyên. Khi đã có dòng chứng từ dùng đơn vị, guard_recorded_unit_policy chặn đổi allowsFraction; lock_line_policy lấy unit FOR SHARE khi ghi dòng.'
}

// -----------------------------------------------------------------------------
// Đại lý và mặt hàng (mang số dư hiện tại)
// -----------------------------------------------------------------------------

Table dms.agency {
  id bigint [pk, not null, increment]
  code text [unique, note: 'Generated stored: DL- ghép id; không phải default.']
  name text [not null, check: `btrim(name) <> ''`]
  "typeId" integer [not null]
  "wardId" integer [not null]
  phone text [check: `phone IS NULL OR btrim(phone) <> ''`]
  address text
  email text [check: `email IS NULL OR (email = btrim(email) AND position('@' IN email) > 1)`]
  "acceptedDate" date [not null]
  debt money_vnd [not null, default: 0, note: 'Nợ hiện tại = Σ phiếu xuất POSTED − Σ phiếu thu POSTED. Âm chỉ khi thanh toán VNPAY về muộn (trả trước).']
  status text [not null, default: 'ACTIVE', check: `status IN ('ACTIVE', 'TERMINATED')`]
  "terminatedAt" timestamptz
  "terminationReason" text
  "createdBy" bigint
  "updatedBy" bigint
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(status = 'TERMINATED') = ("terminatedAt" IS NOT NULL)`
    `status <> 'TERMINATED' OR btrim(coalesce("terminationReason", '')) <> ''`
  }
  indexes {
    (wardId, id) [name: 'ix_agency_ward_active', note: 'PARTIAL: WHERE status = ACTIVE']
    (wardId, id) [name: 'ix_agency_ward']
    (typeId, id) [name: 'ix_agency_type']
    (`lower(name)`) [name: 'ix_agency_name_prefix', note: 'PostgreSQL opclass: text_pattern_ops']
    (`lower(name)`) [name: 'ix_agency_name_contains', note: 'GIN pg_trgm gin_trgm_ops']
    phone [name: 'ix_agency_phone', note: 'PARTIAL: WHERE phone IS NOT NULL']
    (debt, id) [name: 'ix_agency_debt']
  }
  Note: '''
    Tên không cần duy nhất. guard_agency: đại lý mới ACTIVE với debt = 0; TERMINATED không mở lại;
    debt chỉ đổi trong posting_context(); QĐ1 sức chứa phường (ck_agency_ward_capacity, khóa
    business_rule FOR UPDATE); QĐ3 hạn mức khi ghi sổ phiếu xuất (ck_agency_debt_limit) và khi
    đổi loại. guard_agency_history_date: acceptedDate không sau chứng từ đã có. Service chặn
    chấm dứt đại lý còn nợ (AGENCY_HAS_DEBT, 409). Xóa chỉ khi chưa có chứng từ/thanh toán và debt = 0.
  '''
}

Table dms.product {
  id bigint [pk, not null, increment]
  code text [unique, note: 'Generated stored: MH- ghép id; không phải default.']
  name text [not null, check: `btrim(name) <> ''`]
  "unitId" integer [not null]
  stock quantity_value [not null, default: 0, check: `stock >= 0`, note: 'Tồn hiện tại = Σ nhập POSTED − Σ xuất POSTED (ck_product_stock_nonnegative).']
  "lastPurchasePrice" money_vnd [check: `"lastPurchasePrice" IS NULL OR "lastPurchasePrice" > 0`, note: 'Giá nhập gần nhất; NULL = chưa từng nhập, không xuất được (PRODUCT_NOT_PRICED).']
  status text [not null, default: 'ACTIVE', check: `status IN ('ACTIVE', 'INACTIVE')`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    unitId [name: 'ix_product_unit']
    (`lower(name)`) [name: 'ix_product_name_prefix', note: 'PostgreSQL opclass: text_pattern_ops']
    (`lower(name)`) [name: 'ix_product_name_contains', note: 'GIN pg_trgm gin_trgm_ops']
  }
  Note: 'Một đơn vị tính mỗi hàng; bỏ lowStockThreshold. guard_product: hàng mới stock = 0 và chưa có giá; stock/lastPurchasePrice chỉ đổi trong posting_context(); không đổi đơn vị sau khi đã có dòng chứng từ. Giá bán hiển thị = round(lastPurchasePrice × sellingPriceRate).'
}

// -----------------------------------------------------------------------------
// Chứng từ và chi tiết
// -----------------------------------------------------------------------------

Table dms.document {
  id bigint [pk, not null, increment]
  kind text [not null, check: `kind IN ('STOCK_RECEIPT', 'STOCK_ISSUE', 'PAYMENT_RECEIPT')`]
  code text [unique, note: 'Generated stored theo kind: PN-/PX-/PT- ghép id.']
  "agencyId" bigint
  "receiptType" text [check: `"receiptType" IN ('CASH', 'BANK_TRANSFER', 'ONLINE')`, note: 'Chỉ phiếu thu; ONLINE chỉ do IPN VNPAY tạo.']
  "businessDate" date [not null, note: 'Không sau hôm nay (ck_document_business_date); không trước acceptedDate của đại lý.']
  status text [not null, default: 'DRAFT', check: `status IN ('DRAFT', 'POSTED', 'CANCELLED')`]
  "totalAmount" money_vnd [not null, default: 0, check: `"totalAmount" >= 0`]
  "sellingPriceRate" price_rate [note: 'Chỉ phiếu xuất: tỷ lệ chốt khi ghi sổ.']
  note text
  "replacesDocumentId" bigint [unique, note: 'Sửa có lý do: phiếu POSTED này thay cho phiếu đã CANCELLED cùng loại/đại lý.']
  "createdBy" bigint
  "postedBy" bigint [note: 'NULL chỉ với ghi sổ hệ thống (IPN VNPAY).']
  "postedAt" timestamptz
  "cancelledBy" bigint
  "cancelledAt" timestamptz
  "cancelReason" text
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(kind = 'STOCK_RECEIPT') = ("agencyId" IS NULL)`
    `(kind = 'PAYMENT_RECEIPT') = ("receiptType" IS NOT NULL)`
    `"sellingPriceRate" IS NULL OR kind = 'STOCK_ISSUE'`
    `(status = 'DRAFT') = ("postedAt" IS NULL) AND ("postedBy" IS NULL OR "postedAt" IS NOT NULL)`
    `(status = 'CANCELLED') = ("cancelledAt" IS NOT NULL) AND (status <> 'CANCELLED' OR ("cancelledBy" IS NOT NULL AND btrim(coalesce("cancelReason", '')) <> ''))`
    `"replacesDocumentId" IS DISTINCT FROM id`
  }
  indexes {
    (kind, businessDate, id) [name: 'ix_document_kind_date']
    (agencyId, businessDate, id) [name: 'ix_document_agency_date', note: 'PARTIAL: WHERE agencyId IS NOT NULL']
    (businessDate, kind) [name: 'ix_document_posted_date', note: 'PARTIAL: WHERE status = POSTED']
    (kind, id) [name: 'ix_document_drafts', note: 'PARTIAL: WHERE status = DRAFT']
  }
  Note: '''
    PN không có đại lý; PX/PT có đại lý. guard_document: chứng từ bắt đầu DRAFT; nháp được sửa/xóa,
    không hủy; POSTED chỉ nhận chuyển sang CANCELLED (nội dung bất biến); CANCELLED bất biến;
    khi ghi sổ phiếu thu phải > 0 và không có dòng, phiếu hàng phải có dòng khớp totalAmount.
    Hủy/sửa chỉ với chứng từ trong tháng hiện tại (PERIOD_CLOSED, kiểm ở service).
  '''
}

Table dms.document_line {
  id bigint [pk, not null, increment]
  "documentId" bigint [not null]
  "lineNo" integer [not null, check: `"lineNo" > 0`]
  "productId" bigint [not null]
  "unitId" integer [not null]
  "productName" text [not null, check: `btrim("productName") <> ''`]
  "unitName" text [not null, check: `btrim("unitName") <> ''`]
  quantity quantity_value [not null, check: `quantity > 0`]
  "unitPrice" money_vnd [not null, check: `"unitPrice" >= 0`]
  "lineAmount" money_vnd [note: 'Generated stored: round(quantity * unitPrice, 0).']
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (documentId, lineNo) [unique]
    (documentId, productId) [unique]
    (productId, documentId) [name: 'ix_document_line_product']
    unitId [name: 'ix_document_line_unit']
  }
  Note: 'Gắn thẳng vào document (không còn revision). guard_line: chỉ dòng của nháp được thêm/sửa/xóa; phiếu thu không có dòng. lock_line_policy: đơn vị dòng phải là đơn vị hiện tại của mặt hàng và tôn trọng allowsFraction.'
}

// -----------------------------------------------------------------------------
// Thanh toán trực tuyến (VNPAY sandbox)
// -----------------------------------------------------------------------------

Table dms.online_payment {
  id bigint [pk, not null, increment]
  "agencyId" bigint [not null]
  provider text [not null, check: `btrim(provider) <> ''`]
  "merchantReference" text [not null, unique, check: `btrim("merchantReference") <> ''`]
  "idempotencyKey" uuid [not null, unique]
  "providerTransactionId" text
  amount money_vnd [not null, check: `amount > 0`]
  status text [not null, default: 'PENDING', check: `status IN ('PENDING', 'SUCCESS', 'FAILED', 'EXPIRED')`]
  "expiresAt" timestamptz [not null]
  "paymentTime" timestamptz
  "receiptDocumentId" bigint [unique, note: 'FK DEFERRABLE INITIALLY DEFERRED trong SQL.']
  "createdBy" bigint
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `"expiresAt" > "createdAt"`
    `(status = 'SUCCESS') = ("receiptDocumentId" IS NOT NULL)`
    `status <> 'SUCCESS' OR ("paymentTime" IS NOT NULL AND "providerTransactionId" IS NOT NULL)`
  }
  indexes {
    (provider, providerTransactionId) [unique]
    (agencyId, id) [name: 'ix_online_payment_agency']
    (expiresAt, id) [name: 'ix_online_payment_pending', note: 'PARTIAL: WHERE status = PENDING']
  }
  Note: '''
    guard_payment: khởi tạo PENDING, amount ≤ agency.debt (ck_online_payment_debt, QĐ4); danh tính và
    số tiền bất biến; SUCCESS bất biến; FAILED/EXPIRED chỉ nhận SUCCESS muộn đã xác minh.
    Constraint trigger check_online_payment (deferred): SUCCESS cần payment_event SUCCESS và đúng một
    phiếu thu ONLINE POSTED cùng đại lý, cùng số tiền. Không còn hoàn tiền.
  '''
}

Table dms.payment_event {
  id bigint [pk, not null, increment]
  "paymentId" bigint [not null]
  "eventKey" text [not null, check: `btrim("eventKey") <> ''`]
  "providerStatus" text [not null]
  "verifiedPayload" jsonb [not null, default: `'{}'::jsonb`, check: `jsonb_typeof("verifiedPayload") = 'object'`]
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (paymentId, eventKey) [unique]
  }
  Note: 'Append-only (deny_change). Callback IPN/Return đã xác minh chữ ký; chống nhận lặp bằng paymentId/eventKey.'
}

// -----------------------------------------------------------------------------
// Nhật ký
// -----------------------------------------------------------------------------

Table dms.audit_log {
  id bigint [pk, not null, increment]
  "actorId" bigint
  "actorType" text [not null, check: `"actorType" IN ('USER', 'SYSTEM')`]
  "functionCode" text [not null]
  action text [not null, check: `action IN ('INSERT', 'UPDATE', 'DELETE')`]
  "entityName" text [not null]
  "entityKey" text [not null]
  "oldData" jsonb
  "newData" jsonb
  "requestId" text
  "createdAt" timestamptz [not null, default: `clock_timestamp()`]
  "updatedAt" timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `("actorType" = 'USER') = ("actorId" IS NOT NULL)`
  }
  indexes {
    (createdAt, id) [name: 'ix_audit_log_time']
    (actorId, createdAt) [name: 'ix_audit_log_actor']
    (entityName, entityKey, id) [name: 'ix_audit_log_entity']
  }
  Note: 'Append-only; trigger audit_change ghi trước/sau cho app_user, user_group, group_permission, business_rule, agency_type, unit, product, agency, document, document_line, online_payment. Actor/request/function lấy từ dms.actor_id, dms.request_id, dms.function_code; không chép passwordHash/tokenDigest.'
}

// -----------------------------------------------------------------------------
// Quan hệ: khai báo đúng FK SQL.
// Với quan hệ 1:1, đầu bên phải của dấu - là cột FK theo cú pháp DBML.
// -----------------------------------------------------------------------------

Ref fk_app_user_group: dms.app_user.groupId > dms.user_group.id [delete: restrict]
Ref fk_permission_group: dms.group_permission.groupId > dms.user_group.id [delete: restrict]
Ref fk_permission_function: dms.group_permission.functionId > dms.app_function.id [delete: restrict]
Ref fk_auth_token_user: dms.auth_token.userId > dms.app_user.id [delete: restrict]

Ref fk_agency_type: dms.agency.typeId > dms.agency_type.id [delete: restrict]
Ref fk_agency_ward: dms.agency.wardId > dms.ward.id [delete: restrict]
Ref fk_agency_created_by: dms.agency.createdBy > dms.app_user.id [delete: restrict]
Ref fk_agency_updated_by: dms.agency.updatedBy > dms.app_user.id [delete: restrict]
Ref fk_product_unit: dms.product.unitId > dms.unit.id [delete: restrict]

Ref fk_document_agency: dms.document.agencyId > dms.agency.id [delete: restrict]
Ref fk_document_replaces: dms.document.id - dms.document.replacesDocumentId [delete: restrict]
Ref fk_document_created_by: dms.document.createdBy > dms.app_user.id [delete: restrict]
Ref fk_document_posted_by: dms.document.postedBy > dms.app_user.id [delete: restrict]
Ref fk_document_cancelled_by: dms.document.cancelledBy > dms.app_user.id [delete: restrict]

Ref fk_line_document: dms.document_line.documentId > dms.document.id [delete: cascade]
Ref fk_line_product: dms.document_line.productId > dms.product.id [delete: restrict]
Ref fk_line_unit: dms.document_line.unitId > dms.unit.id [delete: restrict]

Ref fk_online_payment_agency: dms.online_payment.agencyId > dms.agency.id [delete: restrict]
// SQL: DEFERRABLE INITIALLY DEFERRED.
Ref fk_online_payment_receipt: dms.document.id - dms.online_payment.receiptDocumentId [delete: restrict]
Ref fk_online_payment_created_by: dms.online_payment.createdBy > dms.app_user.id [delete: restrict]
Ref fk_payment_event_payment: dms.payment_event.paymentId > dms.online_payment.id [delete: restrict]

Ref fk_audit_actor: dms.audit_log.actorId > dms.app_user.id [delete: restrict]
Ref fk_audit_function: dms.audit_log.functionCode > dms.app_function.code [delete: restrict]

