TableGroup identity_and_access {
  dms.user_group
  dms.app_function
  dms.app_user
  dms.group_permission
  dms.auth_token
}

TableGroup master_data {
  dms.business_rule
  dms.ward
  dms.agency_type
  dms.unit
  dms.agency
  dms.product
}

TableGroup business_documents {
  dms.document
  dms.document_line
}

TableGroup online_payments {
  dms.online_payment
  dms.payment_event
}

TableGroup system_audit {
  dms.audit_log
}
